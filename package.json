{
  "name": "mitobyte",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "lint:write": "eslint --fix src",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "chakra typegen ./src/integrations/chakra/mitobyte-theme.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.3.0",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.36.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@storybook/nextjs": "^10.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-storybook": "^10.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^17.0.8",
    "prettier": "^3.3.3",
    "storybook": "^10.5.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md}": "prettier --write",
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.10"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "fsevents@2.3.3": true,
    "fsevents@2.1.3": true,
    "workerd@1.20260708.1": true,
    "sharp@0.34.5": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
