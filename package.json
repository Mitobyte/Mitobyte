{
  "name": "mitobyte",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "lint:write": "eslint --fix src",
    "images": "node scripts/optimize-images.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "chakra typegen ./src/integrations/chakra/mitobyte-theme.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.3.0",
    "resend": "^6.33.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@chromatic-com/storybook": "^5.5.1",
    "@opennextjs/cloudflare": "^1.20.12",
    "@storybook/nextjs": "^10.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "husky": "^9.1.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "storybook": "^10.6.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md}": "prettier --write",
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.1.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "core-js-pure@3.49.0": true
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "@storybook/builder-webpack5": {
      "webpack-dev-middleware": "^7.4.6"
    }
  }
}
