# Response headers for Cloudflare Workers static assets.
# OpenNext copies this file into .open-next/assets at build time.
#
# Everything under /_next/static/ carries a content hash in its filename, so a
# changed file always gets a new URL. Browsers can cache these forever instead
# of revalidating ~40 files on every page view.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
